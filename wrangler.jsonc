{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eselram-provisioner",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/oauth/*"
    ]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://eselram-provisioner.mroschhaden.workers.dev",
    "ESELRAM_TEMPLATE_OWNER": "rouxmrh",
    "ESELRAM_TEMPLATE_REPO": "eselram",
    "GITHUB_OAUTH_SCOPES": "repo read:user user:email",
    "CLOUDFLARE_OAUTH_SCOPES": "d1.write workers-kv-storage.write workers-r2.write workers-scripts.write pages.write account-settings.read memberships.read",
    "RESEND_OAUTH_SCOPE": "full_access",
    "STRIPE_OAUTH_SCOPE": "read_write"
  }
}
